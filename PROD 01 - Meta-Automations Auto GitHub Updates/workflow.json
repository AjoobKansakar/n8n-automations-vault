    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const workflow = item.json;\n\n  // 1. Clean the workflow name (replace |, :, /, \\, ?, \", * with clean dashes)\n  const cleanName = workflow.name\n    .replace(/[|:\\\\\\/\\*\\?\"<>]/g, '-')\n    .replace(/[\\u201C\\u201D]/g, '') // remove curly quotes\n    .replace(/\\s+/g, ' ')          // remove multiple spaces\n    .trim();\n\n  // 2. Define the path inside your GitHub repo\n  const filePath = `${cleanName}/workflow.json`;\n\n  // 3. Convert the entire workflow into a formatted JSON string\n  const fileContent = JSON.stringify(workflow, null, 2);\n\n  // 4. Return clean data ready for GitHub\n  return {\n    json: {\n      workflow_id: workflow.id,\n      original_name: workflow.name,\n      clean_name: cleanName,\n      file_path: filePath,\n      file_content: fileContent,\n      updated_at: workflow.updatedAt\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
