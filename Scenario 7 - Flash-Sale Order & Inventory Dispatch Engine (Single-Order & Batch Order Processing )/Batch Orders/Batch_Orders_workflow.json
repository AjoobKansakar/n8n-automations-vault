    {
      "parameters": {
        "jsCode": "const groupedOrders = {};\n\nfor (const item of $input.all()) {\n  const data = item.json;\n  const orderId = data.order_id;\n  const itemTotal = Number(data.Total) || (data.quantity * data.unit_price);\n\n  // If new order, initialize clean container\n  if (!groupedOrders[orderId]) {\n    groupedOrders[orderId] = {\n      status: \"Order Confirmed & Sent to Warehouse\",\n      order_id: orderId,\n      customer_name: data.customer_name,\n      total_items: 0,\n      grand_total: 0,\n      packing_list: []\n    };\n  }\n\n  // 1. Accumulate totals\n  groupedOrders[orderId].total_items += data.quantity;\n  groupedOrders[orderId].grand_total += itemTotal;\n\n  // 2. Push ONLY product-specific fields (No redundant order_id/customer_name!)\n  groupedOrders[orderId].packing_list.push({\n    product_id: data.product_id,\n    product_name: data.product_name,\n    quantity: data.quantity,\n    unit_price: data.unit_price,\n    shelf: data.product_location,\n    supplier: data.supplier,\n    line_total: itemTotal\n  });\n}\n\n// Return as 2 distinct n8n items\nreturn Object.values(groupedOrders).map(order => ({ json: order }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
